; fatatest.mac — FAT allocation primitives test (FATFREE + FATWEN)
;
; Reversible, so it never permanently changes the card:
;   1. FATFREE -> a free cluster C
;   2. confirm FATNX(C) is really 0 (abort if not - never write a used
;      cluster)
;   3. FATWEN(C, 0xFFFF) -> mark end-of-chain
;   4. verify the value came back from BOTH FAT copies
;   5. FATWEN(C, 0) -> free it again, verify
; The FAT ends exactly as it started.
;
; Assemble:	part of fatatest.prj (origin 1000); run with P or 1000G.

.	= 1000

XCSR	= 177564		; console transmit status (bit 7 = ready)
XBUF	= 177566		; console transmit buffer

START:	MOV	#340, @#177776	; priority 7
	MOV	#1000, SP
	MOV	#MHELLO, R1
	JSR	PC, PMSG

	JSR	PC, SDINI
	TST	R0
	BEQ	MOUNT
	MOV	#MNOSD, R1
	JSR	PC, PMSG
	HALT
MOUNT:	JSR	PC, FATMNT
	TST	R0
	BEQ	FINDF
	MOV	#MNOMNT, R1
	JSR	PC, PMSG
	HALT

; ---- find a free cluster and prove it's free ------------------------

FINDF:	JSR	PC, FATFREE
	MOV	R0, CLUS
	BNE	GOTF
	MOV	#MNOFRE, R1
	JSR	PC, PMSG
	HALT
GOTF:	MOV	#MFREE, R1
	JSR	PC, PMSG
	MOV	CLUS, R0
	JSR	PC, PHEX4
	JSR	PC, PCRLF

	MOV	CLUS, R0	; safety: it must currently read 0
	JSR	PC, FATNX
	TST	R0
	BEQ	DOWR
	MOV	#MUSED, R1	; FATFREE lied - do NOT write it
	JSR	PC, PMSG
	HALT

; ---- write an EOC marker, verify both copies ------------------------

DOWR:	MOV	#MPRE, R1	; DIAG: raw FAT1 sector, bytes 0-9, before
	JSR	PC, PMSG
	JSR	PC, RDUMP
	MOV	#MWR, R1
	JSR	PC, PMSG
	MOV	CLUS, R0
	MOV	#177777, R1	; 0xFFFF
	JSR	PC, FATWEN
	TST	R0
	BEQ	VDIAG
	MOV	#MWRER, R1
	JSR	PC, PMSG
	HALT
VDIAG:	MOV	#MPOST, R1	; DIAG: raw FAT1 sector, bytes 0-9, after
	JSR	PC, PMSG
	JSR	PC, RDUMP

VC1:	MOV	CLUS, R0	; copy 1, via the normal reader
	JSR	PC, FATNX
	MOV	R0, R4		; save before PMSG clobbers R0
	MOV	#MC1, R1
	JSR	PC, PMSG
	MOV	R4, R0
	JSR	PC, PHEX4
	JSR	PC, PCRLF
	CMP	R4, #177777
	BNE	VBAD

	CMP	NFATS, #2	; copy 2, read directly (if present)
	BLO	WROK
	JSR	PC, RDF2
	MOV	R0, R4		; save before PMSG
	MOV	#MC2, R1
	JSR	PC, PMSG
	MOV	R4, R0
	JSR	PC, PHEX4
	JSR	PC, PCRLF
	CMP	R4, #177777
	BNE	VBAD

WROK:	MOV	#MWROK, R1
	JSR	PC, PMSG
	BR	RESTOR
VBAD:	MOV	#MVBAD, R1
	JSR	PC, PMSG
	; fall through to RESTORE anyway - always put the FAT back

; ---- restore the cluster to free, verify ----------------------------

RESTOR:	MOV	#MREST, R1
	JSR	PC, PMSG
	MOV	CLUS, R0
	CLR	R1
	JSR	PC, FATWEN
	MOV	CLUS, R0
	JSR	PC, FATNX
	MOV	R0, R4		; save before PMSG
	MOV	#MAFT, R1
	JSR	PC, PMSG
	MOV	R4, R0
	JSR	PC, PHEX4
	JSR	PC, PCRLF
	TST	R4
	BEQ	RGOOD
	MOV	#MRBAD, R1
	JSR	PC, PMSG
	HALT
RGOOD:	MOV	#MDONE, R1
	JSR	PC, PMSG
	HALT
	JMP	START

; ---- DIAG: read FAT1 sector 0 (FATLBA) and print bytes 0-9 hex ------

RDUMP:	MOV	FATLBA, R0
	MOV	FATLBA+2, R1
	MOV	#TBUF, R2
	JSR	PC, SDRD
	MOV	#TBUF, R4
	MOV	#^D10, R3
RD1:	CLR	R0
	BISB	(R4)+, R0
	JSR	PC, PHEX2
	MOV	#40, R0
	JSR	PC, PUTC
	SOB	R3, RD1
	JSR	PC, PCRLF
	RTS	PC

; ---- read FAT copy 2's entry for CLUS -> R0 -------------------------
; sector = FATLBA + SPFAT + (CLUS>>8); byte = (CLUS & 0xFF)*2.

RDF2:	MOV	CLUS, R4
	SWAB	R4
	BIC	#177400, R4
	MOV	CLUS, R5
	BIC	#177400, R5
	ASL	R5
	MOV	FATLBA, R0
	MOV	FATLBA+2, R1
	ADD	SPFAT, R0
	ADC	R1
	ADD	R4, R0
	ADC	R1
	MOV	#TBUF, R2
	JSR	PC, SDRD
	ADD	#TBUF, R5
	MOV	(R5), R0
	RTS	PC

; ---- console ---------------------------------------------------------

PMSG:	MOVB	(R1)+, R0
	BEQ	PMSG2
	JSR	PC, PUTC
	BR	PMSG
PMSG2:	RTS	PC

PCRLF:	MOV	#15, R0
	JSR	PC, PUTC
	MOV	#12, R0
	JSR	PC, PUTC
	RTS	PC

PUTC:	TSTB	@#XCSR
	BPL	PUTC
	MOVB	R0, @#XBUF
	RTS	PC

PHEX4:	MOV	R0, -(SP)
	SWAB	R0
	JSR	PC, PHEX2
	MOV	(SP)+, R0
	JSR	PC, PHEX2
	RTS	PC

PHEX2:	BIC	#177400, R0
	MOV	R0, -(SP)
	ASR	R0
	ASR	R0
	ASR	R0
	ASR	R0
	JSR	PC, PNIB
	MOV	(SP)+, R0
	JSR	PC, PNIB
	RTS	PC

PNIB:	BIC	#177760, R0
	CMP	R0, #^D9
	BGT	PNA
	ADD	#60, R0
	BR	PNP
PNA:	ADD	#^D55, R0
PNP:	JSR	PC, PUTC
	RTS	PC

; ---- messages and buffer --------------------------------------------

MHELLO:	.ASCII	/FATATEST - FAT alloc primitives/
	.BYTE	15, 12, 0
MNOSD:	.ASCII	/SD INIT FAILED/
	.BYTE	15, 12, 0
MNOMNT:	.ASCII	/MOUNT FAILED/
	.BYTE	15, 12, 0
MNOFRE:	.ASCII	/NO FREE CLUSTER/
	.BYTE	15, 12, 0
MFREE:	.ASCII	/FREE CLUSTER = /
	.BYTE	0
MUSED:	.ASCII	/ABORT - CLUSTER NOT ACTUALLY FREE/
	.BYTE	15, 12, 0
MPRE:	.ASCII	/FAT1 pre : /
	.BYTE	0
MPOST:	.ASCII	/FAT1 post: /
	.BYTE	0
MWR:	.ASCII	/WRITE EOC.../
	.BYTE	15, 12, 0
MWRER:	.ASCII	/FATWEN FAILED/
	.BYTE	15, 12, 0
MC1:	.ASCII	/  FAT1 = /
	.BYTE	0
MC2:	.ASCII	/  FAT2 = /
	.BYTE	0
MWROK:	.ASCII	/WRITE OK - both copies hold FFFF/
	.BYTE	15, 12, 0
MVBAD:	.ASCII	/VERIFY FAILED/
	.BYTE	15, 12, 0
MREST:	.ASCII	/RESTORE.../
	.BYTE	15, 12, 0
MAFT:	.ASCII	/  after = /
	.BYTE	0
MRBAD:	.ASCII	/RESTORE FAILED - FAT LEFT DIRTY/
	.BYTE	15, 12, 0
MDONE:	.ASCII	/DONE - FAT unchanged/
	.BYTE	15, 12, 0
	.EVEN

CLUS:	.WORD	0		; the cluster under test
	.EVEN
TBUF:	.BLKB	^D512		; scratch for the FAT2 read
	.EVEN

	.INCLUDE "../fat16/fat16.mac"
	.INCLUDE "../sddrv/sd.mac"

	.END	START
