; fatctest.mac — FAT16 file-create test (fat16.mac FATCRE)
;
; Creates PDPFILE.TXT in the root with a short message, then re-opens it
; and verifies the read-back matches. Re-runnable: on the second run the
; file already exists, so it reports that and just verifies the persisted
; copy (proving the earlier create stuck). The file is left on the card -
; mount it on a PC and PDPFILE.TXT is there with the PDP-11's text.
;
; One cluster / one sector (message < 512 bytes).
;
; Assemble:	part of fatctest.prj (origin 1000); run with P or 1000G.

.	= 1000

XCSR	= 177564		; console transmit status (bit 7 = ready)
XBUF	= 177566		; console transmit buffer

START:	MOV	#340, @#177776	; priority 7
	MOV	#1000, SP
	MOV	#MHELLO, R1
	JSR	PC, PMSG

	JSR	PC, SDINI
	TST	R0
	BEQ	MOUNT
	MOV	#MNOSD, R1
	JSR	PC, PMSG
	HALT
MOUNT:	JSR	PC, FATMNT
	TST	R0
	BEQ	BUILD
	MOV	#MNOMNT, R1
	JSR	PC, PMSG
	HALT

; ---- build the 512-byte data buffer (message + zero pad) ------------

BUILD:	MOV	#DATABUF, R2
	MOV	#MSG, R3
	MOV	#MLEN, R4
BLD1:	MOVB	(R3)+, (R2)+
	SOB	R4, BLD1
	MOV	#^D512, R4
	SUB	#MLEN, R4
BLD2:	CLRB	(R2)+
	SOB	R4, BLD2

; ---- create ---------------------------------------------------------

	MOV	#FNAME, R1
	MOV	#DATABUF, R2
	MOV	#MLEN, R3
	JSR	PC, FATCRE
	MOV	R0, R4		; result code
	TST	R4
	BEQ	CREOK
	CMP	R4, #2
	BEQ	EXIST
	MOV	#MCERR, R1	; some other error - print the code
	JSR	PC, PMSG
	MOV	R4, R0
	ADD	#60, R0
	JSR	PC, PUTC
	JSR	PC, PCRLF
	HALT
CREOK:	MOV	#MCRE, R1
	JSR	PC, PMSG
	BR	VERIFY
EXIST:	MOV	#MEX, R1
	JSR	PC, PMSG

; ---- read back and verify -------------------------------------------

VERIFY:	MOV	#FNAME, R1
	JSR	PC, FATOPN
	TST	R0
	BEQ	VRD
	MOV	#MVNOF, R1
	JSR	PC, PMSG
	HALT
VRD:	MOV	#RDBUF, R2
	JSR	PC, FATRD
	MOV	R0, R3		; bytes read = file size

	MOV	R3, R1		; compare R3 bytes with the message
	MOV	#RDBUF, R4
	MOV	#MSG, R5
VC:	CLR	R0
	BISB	(R4)+, R0
	CLR	R2
	BISB	(R5)+, R2
	CMP	R0, R2
	BNE	VMISM
	SOB	R1, VC
	MOV	#MVOK, R1
	JSR	PC, PMSG
	BR	SHOW
VMISM:	MOV	#MVBAD, R1
	JSR	PC, PMSG

; ---- show the file contents -----------------------------------------

SHOW:	MOV	#MSHOW, R1
	JSR	PC, PMSG
	MOV	#RDBUF, R4
DB1:	CLR	R0
	BISB	(R4)+, R0
	CMP	R0, #15		; swallow CR
	BEQ	DB2
	CMP	R0, #12		; LF -> CR+LF
	BEQ	DBNL
	CMP	R0, #40
	BLO	DBDOT
	CMP	R0, #176
	BHI	DBDOT
	JSR	PC, PUTC
	BR	DB2
DBNL:	JSR	PC, PCRLF
	BR	DB2
DBDOT:	MOV	#56, R0
	JSR	PC, PUTC
DB2:	SOB	R3, DB1
	JSR	PC, PCRLF
	MOV	#MDONE, R1
	JSR	PC, PMSG
	HALT
	JMP	START

; ---- console ---------------------------------------------------------

PMSG:	MOVB	(R1)+, R0
	BEQ	PMSG2
	JSR	PC, PUTC
	BR	PMSG
PMSG2:	RTS	PC

PCRLF:	MOV	#15, R0
	JSR	PC, PUTC
	MOV	#12, R0
	JSR	PC, PUTC
	RTS	PC

PUTC:	TSTB	@#XCSR
	BPL	PUTC
	MOVB	R0, @#XBUF
	RTS	PC

; ---- name, messages, buffers ----------------------------------------

FNAME:	.ASCII	/PDPFILE TXT/	; 8.3: PDPFILE + space + TXT
	.EVEN

MSG:	.ASCII	/Created by the DCJ-11 over bit-banged SPI!/
	.BYTE	15, 12
MEND:
MLEN	= MEND - MSG
	.EVEN

MHELLO:	.ASCII	/FATCTEST - create PDPFILE.TXT/
	.BYTE	15, 12, 0
MNOSD:	.ASCII	/SD INIT FAILED/
	.BYTE	15, 12, 0
MNOMNT:	.ASCII	/MOUNT FAILED/
	.BYTE	15, 12, 0
MCRE:	.ASCII	/CREATED/
	.BYTE	15, 12, 0
MEX:	.ASCII	/ALREADY EXISTS (verifying)/
	.BYTE	15, 12, 0
MCERR:	.ASCII	/CREATE ERROR CODE /
	.BYTE	0
MVNOF:	.ASCII	/OPEN AFTER CREATE FAILED/
	.BYTE	15, 12, 0
MVOK:	.ASCII	/VERIFIED - readback matches/
	.BYTE	15, 12, 0
MVBAD:	.ASCII	/MISMATCH ON READBACK/
	.BYTE	15, 12, 0
MSHOW:	.ASCII	/--- FILE CONTENTS ---/
	.BYTE	15, 12, 0
MDONE:	.ASCII	/--- DONE (PDPFILE.TXT on the card)/
	.BYTE	15, 12, 0
	.EVEN

DATABUF:.BLKB	^D512		; data to write (message + pad)
	.EVEN
RDBUF:	.BLKB	^D512		; read-back buffer
	.EVEN

	.INCLUDE "../fat16/fat16.mac"
	.INCLUDE "../sddrv/sd.mac"

	.END	START
