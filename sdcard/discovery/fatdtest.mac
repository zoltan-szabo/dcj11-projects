; fatdtest.mac — FAT16 file-delete test (fat16.mac FATDEL)
;
; Self-contained and self-cleaning: creates DELME.TXT, confirms it's
; there, deletes it, and confirms it's gone. The cluster is freed and
; the directory entry marked 0xE5, so the card ends as it began (minus
; nothing). Re-runnable.
;
; Assemble:	part of fatdtest.prj (origin 1000); run with P or 1000G.

.	= 1000

XCSR	= 177564		; console transmit status (bit 7 = ready)
XBUF	= 177566		; console transmit buffer

START:	MOV	#340, @#177776	; priority 7
	MOV	#1000, SP
	MOV	#MHELLO, R1
	JSR	PC, PMSG

	JSR	PC, SDINI
	TST	R0
	BEQ	MOUNT
	MOV	#MNOSD, R1
	JSR	PC, PMSG
	HALT
MOUNT:	JSR	PC, FATMNT
	TST	R0
	BEQ	MAKE
	MOV	#MNOMNT, R1
	JSR	PC, PMSG
	HALT

; ---- create the throwaway file --------------------------------------

MAKE:	MOV	#DATABUF, R2	; fill the data buffer
	MOV	#MSG, R3
	MOV	#MLEN, R4
MK1:	MOVB	(R3)+, (R2)+
	SOB	R4, MK1
	MOV	#^D512, R4
	SUB	#MLEN, R4
MK2:	CLRB	(R2)+
	SOB	R4, MK2

	MOV	#FNAME, R1
	MOV	#DATABUF, R2
	MOV	#MLEN, R3
	JSR	PC, FATCRE
	MOV	R0, R4
	BEQ	CROK
	CMP	R4, #2		; 2 = already exists, also fine
	BEQ	CROK
	MOV	#MCERR, R1
	JSR	PC, PMSG
	MOV	R4, R0
	ADD	#60, R0
	JSR	PC, PUTC
	JSR	PC, PCRLF
	HALT
CROK:	MOV	#MMADE, R1
	JSR	PC, PMSG

; ---- confirm it exists ----------------------------------------------

	JSR	PC, FATDIR0
	MOV	#FNAME, R1
	JSR	PC, FATOPN
	TST	R0
	BEQ	HAVEIT
	MOV	#MNOEX, R1
	JSR	PC, PMSG
	HALT
HAVEIT:	MOV	#MEXIST, R1
	JSR	PC, PMSG

; ---- delete ---------------------------------------------------------

	MOV	#FNAME, R1
	JSR	PC, FATDEL
	TST	R0
	BEQ	DELOK
	MOV	#MDERR, R1
	JSR	PC, PMSG
	MOV	R0, R0
	ADD	#60, R0
	JSR	PC, PUTC
	JSR	PC, PCRLF
	HALT
DELOK:	MOV	#MDEL, R1
	JSR	PC, PMSG

; ---- confirm it is gone ---------------------------------------------

	JSR	PC, FATDIR0
	MOV	#FNAME, R1
	JSR	PC, FATOPN
	TST	R0
	BNE	VGONE
	MOV	#MSTILL, R1
	JSR	PC, PMSG
	HALT
VGONE:	MOV	#MGONE, R1
	JSR	PC, PMSG
	MOV	#MDONE, R1
	JSR	PC, PMSG
	HALT
	JMP	START

; ---- console ---------------------------------------------------------

PMSG:	MOVB	(R1)+, R0
	BEQ	PMSG2
	JSR	PC, PUTC
	BR	PMSG
PMSG2:	RTS	PC

PCRLF:	MOV	#15, R0
	JSR	PC, PUTC
	MOV	#12, R0
	JSR	PC, PUTC
	RTS	PC

PUTC:	TSTB	@#XCSR
	BPL	PUTC
	MOVB	R0, @#XBUF
	RTS	PC

; ---- name, messages, buffer -----------------------------------------

FNAME:	.ASCII	/DELME   TXT/	; 8.3: DELME + 3 spaces + TXT
	.EVEN

MSG:	.ASCII	/scratch file - about to be deleted/
	.BYTE	15, 12
MEND:
MLEN	= MEND - MSG
	.EVEN

MHELLO:	.ASCII	/FATDTEST - create then delete DELME.TXT/
	.BYTE	15, 12, 0
MNOSD:	.ASCII	/SD INIT FAILED/
	.BYTE	15, 12, 0
MNOMNT:	.ASCII	/MOUNT FAILED/
	.BYTE	15, 12, 0
MCERR:	.ASCII	/CREATE ERROR CODE /
	.BYTE	0
MMADE:	.ASCII	/CREATED DELME.TXT/
	.BYTE	15, 12, 0
MNOEX:	.ASCII	/NOT FOUND AFTER CREATE/
	.BYTE	15, 12, 0
MEXIST:	.ASCII	/CONFIRMED PRESENT/
	.BYTE	15, 12, 0
MDERR:	.ASCII	/DELETE ERROR CODE /
	.BYTE	0
MDEL:	.ASCII	/DELETED/
	.BYTE	15, 12, 0
MSTILL:	.ASCII	/STILL PRESENT - DELETE DID NOT TAKE/
	.BYTE	15, 12, 0
MGONE:	.ASCII	/CONFIRMED GONE/
	.BYTE	15, 12, 0
MDONE:	.ASCII	/--- DONE (card unchanged)/
	.BYTE	15, 12, 0
	.EVEN

DATABUF:.BLKB	^D512
	.EVEN

	.INCLUDE "../fat16/fat16.mac"
	.INCLUDE "../sddrv/sd.mac"

	.END	START
