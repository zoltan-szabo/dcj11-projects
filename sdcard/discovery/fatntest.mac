; fatntest.mac — FAT16 file rename test (fat16.mac FATREN)
;
; Creates RENFROM.TXT, renames it to RENTO.TXT, then verifies RENTO.TXT
; exists with the same data and RENFROM.TXT is gone. Deletes RENTO.TXT
; at the end. Self-cleaning and re-runnable.
;
; Assemble:	part of fatntest.prj (origin 1000); run with P or 1000G.

.	= 1000

XCSR	= 177564		; console transmit status (bit 7 = ready)
XBUF	= 177566		; console transmit buffer

START:	MOV	#340, @#177776	; priority 7
	MOV	#1000, SP
	MOV	#MHELLO, R1
	JSR	PC, PMSG

	JSR	PC, SDINI
	TST	R0
	BEQ	MOUNT
	MOV	#MNOSD, R1
	JSR	PC, PMSG
	HALT
MOUNT:	JSR	PC, FATMNT
	TST	R0
	BEQ	MAKE
	MOV	#MNOMNT, R1
	JSR	PC, PMSG
	HALT

; ---- clean slate, create RENFROM.TXT --------------------------------

MAKE:	MOV	#NFROM, R1	; clear any leftovers
	JSR	PC, FATDEL
	MOV	#NTO, R1
	JSR	PC, FATDEL

	MOV	#DATABUF, R2	; fill the data
	MOV	#MSG, R3
	MOV	#MLEN, R4
MK1:	MOVB	(R3)+, (R2)+
	SOB	R4, MK1

	MOV	#NFROM, R1
	MOV	#DATABUF, R2
	MOV	#MLEN, R3
	JSR	PC, FATCRE
	TST	R0
	BEQ	MADE
	MOV	#MCERR, R1
	JSR	PC, PMSG
	HALT
MADE:	MOV	#MMADE, R1
	JSR	PC, PMSG

; ---- rename ---------------------------------------------------------

	MOV	#NFROM, R1
	MOV	#NTO, R2
	JSR	PC, FATREN
	MOV	R0, R4		; save code before PMSG
	TST	R4
	BEQ	RENOK
	MOV	#MRERR, R1
	JSR	PC, PMSG
	MOV	R4, R0
	ADD	#60, R0
	JSR	PC, PUTC
	JSR	PC, PCRLF
	HALT
RENOK:	MOV	#MREN, R1
	JSR	PC, PMSG

; ---- verify new name present + data intact --------------------------

	MOV	#NTO, R1
	JSR	PC, FATOPN
	TST	R0
	BEQ	VTO
	MOV	#MNOTO, R1
	JSR	PC, PMSG
	HALT
VTO:	MOV	#RDBUF, R2
	JSR	PC, FATRD
	MOV	R0, R3
	MOV	#RDBUF, R4
	MOV	#MSG, R5
VD:	CLR	R0
	BISB	(R4)+, R0
	CLR	R1
	BISB	(R5)+, R1
	CMP	R0, R1
	BNE	VDBAD
	SOB	R3, VD
	MOV	#MTOOK, R1
	JSR	PC, PMSG
	BR	VFROM
VDBAD:	MOV	#MDBAD, R1
	JSR	PC, PMSG
	HALT

; ---- verify old name gone -------------------------------------------

VFROM:	MOV	#NFROM, R1
	JSR	PC, FATOPN
	TST	R0
	BNE	GONE
	MOV	#MSTILL, R1
	JSR	PC, PMSG
	HALT
GONE:	MOV	#MGONE, R1
	JSR	PC, PMSG

; ---- cleanup --------------------------------------------------------

	MOV	#NTO, R1
	JSR	PC, FATDEL
	MOV	#MDONE, R1
	JSR	PC, PMSG
	HALT
	JMP	START

; ---- console ---------------------------------------------------------

PMSG:	MOVB	(R1)+, R0
	BEQ	PMSG2
	JSR	PC, PUTC
	BR	PMSG
PMSG2:	RTS	PC

PCRLF:	MOV	#15, R0
	JSR	PC, PUTC
	MOV	#12, R0
	JSR	PC, PUTC
	RTS	PC

PUTC:	TSTB	@#XCSR
	BPL	PUTC
	MOVB	R0, @#XBUF
	RTS	PC

; ---- names, messages, buffers ---------------------------------------

NFROM:	.ASCII	/RENFROM TXT/	; 8.3: RENFROM + space + TXT
NTO:	.ASCII	/RENTO   TXT/	; 8.3: RENTO + 3 spaces + TXT
	.EVEN

MSG:	.ASCII	/renamed from RENFROM.TXT to RENTO.TXT/
	.BYTE	15, 12
MEND:
MLEN	= MEND - MSG
	.EVEN

MHELLO:	.ASCII	/FATNTEST - rename RENFROM.TXT -> RENTO.TXT/
	.BYTE	15, 12, 0
MNOSD:	.ASCII	/SD INIT FAILED/
	.BYTE	15, 12, 0
MNOMNT:	.ASCII	/MOUNT FAILED/
	.BYTE	15, 12, 0
MCERR:	.ASCII	/CREATE FAILED/
	.BYTE	15, 12, 0
MMADE:	.ASCII	/CREATED RENFROM.TXT/
	.BYTE	15, 12, 0
MRERR:	.ASCII	/RENAME ERROR CODE /
	.BYTE	0
MREN:	.ASCII	/RENAMED/
	.BYTE	15, 12, 0
MNOTO:	.ASCII	/RENTO.TXT NOT FOUND/
	.BYTE	15, 12, 0
MTOOK:	.ASCII	/RENTO.TXT PRESENT - data intact/
	.BYTE	15, 12, 0
MDBAD:	.ASCII	/DATA MISMATCH AFTER RENAME/
	.BYTE	15, 12, 0
MSTILL:	.ASCII	/RENFROM.TXT STILL PRESENT/
	.BYTE	15, 12, 0
MGONE:	.ASCII	/RENFROM.TXT GONE/
	.BYTE	15, 12, 0
MDONE:	.ASCII	/--- DONE (card clean)/
	.BYTE	15, 12, 0
	.EVEN

DATABUF:.BLKB	^D512
	.EVEN
RDBUF:	.BLKB	^D512
	.EVEN

	.INCLUDE "../fat16/fat16.mac"
	.INCLUDE "../sddrv/sd.mac"

	.END	START
