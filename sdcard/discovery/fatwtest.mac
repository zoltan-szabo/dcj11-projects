; fatwtest.mac — FAT16 overwrite-in-place test (fat16.mac FATWR)
;
; Opens TEST.TXT in the root, overwrites its data in place with a
; repeating message of the SAME length (no size change, so no FAT or
; directory update), reads it back, verifies, and prints the new
; contents. The file is LEFT CHANGED on purpose - mount the card on a
; PC afterward and you'll see the PDP-11's text in TEST.TXT.
;
; Handles a file up to one sector (512 bytes) for the read-back/verify;
; the overwrite itself follows the whole chain. TEST.TXT (a few dozen
; bytes) fits. Put a TEST.TXT on the card first.
;
; Assemble:	part of fatwtest.prj (origin 1000); run with P or 1000G.

.	= 1000

XCSR	= 177564		; console transmit status (bit 7 = ready)
XBUF	= 177566		; console transmit buffer

START:	MOV	#340, @#177776	; priority 7
	MOV	#1000, SP
	MOV	#MHELLO, R1
	JSR	PC, PMSG

	JSR	PC, SDINI
	TST	R0
	BEQ	MOUNT
	MOV	#MNOSD, R1
	JSR	PC, PMSG
	HALT
MOUNT:	JSR	PC, FATMNT
	TST	R0
	BEQ	OPEN
	MOV	#MNOMNT, R1
	JSR	PC, PMSG
	HALT

OPEN:	MOV	#FNAME, R1	; open TEST.TXT
	JSR	PC, FATOPN
	TST	R0
	BEQ	FILLNB
	MOV	#MNOFIL, R1
	JSR	PC, PMSG
	HALT

; ---- build the replacement buffer (cyclic copy of MSGSRC) -----------

FILLNB:	MOV	#NEWBUF, R2
	MOV	#MSGSRC, R3
	MOV	#^D512, R4
NBF1:	MOVB	(R3)+, (R2)+
	CMP	R3, #MSGEND
	BLO	NBF2
	MOV	#MSGSRC, R3	; wrap the source
NBF2:	SOB	R4, NBF1

; ---- overwrite in place ---------------------------------------------

	MOV	#MWR, R1
	JSR	PC, PMSG
OW1:	MOV	#NEWBUF, R2
	JSR	PC, FATWR
	TST	R0
	BNE	OW1		; more sectors: keep writing the pattern
	TST	FSIZE		; FSIZE hit 0 -> clean finish
	BNE	OWERR
	TST	FSIZE+2
	BNE	OWERR
	BR	VERIFY
OWERR:	MOV	#MWRER, R1
	JSR	PC, PMSG
	HALT

; ---- read back and verify -------------------------------------------

VERIFY:	MOV	#FNAME, R1
	JSR	PC, FATOPN	; re-open (resets the file position)
	TST	R0
	BNE	OWERR
	MOV	#VERBUF, R2
	JSR	PC, FATRD
	MOV	R0, R3		; bytes read = file size (<= 512 here)
	MOV	#MRD, R1
	JSR	PC, PMSG

	MOV	R3, R1		; compare R3 bytes vs NEWBUF
	MOV	#VERBUF, R4
	MOV	#NEWBUF, R5
CM1:	CLR	R0
	BISB	(R4)+, R0
	CLR	R2
	BISB	(R5)+, R2
	CMP	R0, R2
	BNE	CBAD
	SOB	R1, CM1
	MOV	#MOK, R1
	JSR	PC, PMSG
	BR	SHOW
CBAD:	MOV	#MBAD, R1
	JSR	PC, PMSG

; ---- show the new file contents -------------------------------------

SHOW:	MOV	#MSHOW, R1
	JSR	PC, PMSG
	MOV	#VERBUF, R4	; print R3 bytes as text
DB1:	CLR	R0
	BISB	(R4)+, R0
	CMP	R0, #15		; swallow CR
	BEQ	DB2
	CMP	R0, #12		; LF -> CR+LF
	BEQ	DBNL
	CMP	R0, #40
	BLO	DBDOT
	CMP	R0, #176
	BHI	DBDOT
	JSR	PC, PUTC
	BR	DB2
DBNL:	JSR	PC, PCRLF
	BR	DB2
DBDOT:	MOV	#56, R0
	JSR	PC, PUTC
DB2:	SOB	R3, DB1
	JSR	PC, PCRLF
	MOV	#MDONE, R1
	JSR	PC, PMSG
	HALT
	JMP	START

; ---- console ---------------------------------------------------------

PMSG:	MOVB	(R1)+, R0
	BEQ	PMSG2
	JSR	PC, PUTC
	BR	PMSG
PMSG2:	RTS	PC

PCRLF:	MOV	#15, R0
	JSR	PC, PUTC
	MOV	#12, R0
	JSR	PC, PUTC
	RTS	PC

PUTC:	TSTB	@#XCSR
	BPL	PUTC
	MOVB	R0, @#XBUF
	RTS	PC

; ---- name, message, buffers -----------------------------------------

FNAME:	.ASCII	/TEST    TXT/	; 8.3 padded: TEST + 4 spaces + TXT
	.EVEN

MHELLO:	.ASCII	/FATWTEST - overwrite TEST.TXT/
	.BYTE	15, 12, 0
MNOSD:	.ASCII	/SD INIT FAILED/
	.BYTE	15, 12, 0
MNOMNT:	.ASCII	/MOUNT FAILED/
	.BYTE	15, 12, 0
MNOFIL:	.ASCII	/TEST.TXT NOT FOUND/
	.BYTE	15, 12, 0
MWR:	.ASCII	/OVERWRITING.../
	.BYTE	15, 12, 0
MWRER:	.ASCII	/WRITE FAILED/
	.BYTE	15, 12, 0
MRD:	.ASCII	/READ BACK.../
	.BYTE	15, 12, 0
MOK:	.ASCII	/VERIFIED - readback matches/
	.BYTE	15, 12, 0
MBAD:	.ASCII	/MISMATCH ON READBACK/
	.BYTE	15, 12, 0
MSHOW:	.ASCII	/--- NEW CONTENTS ---/
	.BYTE	15, 12, 0
MDONE:	.ASCII	/--- DONE (TEST.TXT changed - check it on a PC)/
	.BYTE	15, 12, 0

MSGSRC:	.ASCII	/PDP-11 wrote this over bit-banged SPI. /
MSGEND:
	.EVEN

NEWBUF:	.BLKB	^D512		; replacement data (cyclic pattern)
	.EVEN
VERBUF:	.BLKB	^D512		; read-back buffer
	.EVEN

	.INCLUDE "../fat16/fat16.mac"
	.INCLUDE "../sddrv/sd.mac"

	.END	START
