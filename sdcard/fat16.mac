; fat16.mac — read-only FAT16 on top of sd.mac (raw SD sector I/O)
;
; Mounts the first MBR partition, reads its BPB, computes the on-disk
; geometry, and offers a directory iterator (root or any subdirectory),
; whole-file reading, overwrite-in-place, the FAT allocation primitives
; (free-cluster search + FAT-entry write), and file create (multi-cluster
; chain) + delete + rename in the root. No subdirectory writes yet.
; 8.3 names only (long-name entries skipped).
;
; All sector numbers are 32-bit LBAs, held as word pairs (low, high) and
; passed to sd.mac's SDRD in the R0:R1 register pair. Cluster arithmetic
; uses the J-11 EIS MUL (16x16 -> 32 in a register pair).
;
; API (rely on SDINI having succeeded first):
;	FATMNT	read MBR + BPB, compute geometry -> R0 = 0 ok, else:
;		  1 bad MBR signature   2 bad BPB signature
;		  3 SD read error
;	FATDIR0	make the root directory current, rewound
;	FATCD	R0 = a subdirectory's first cluster (a DECLUS from a
;		listing, or a ".." cluster; 0 = root) -> make it current
;	FATREW	rewind the current directory to its start
;	FATNXT	next valid 8.3 entry of the current directory -> R0 = 0
;		got one / 1 = end. Fields land in DENAME (11 bytes),
;		DEATTR, DECLUS, DESIZE (DESIZE is a 32-bit low,high pair).
;		A subdirectory is DEATTR bit 0x10; descend with FATCD DECLUS.
;	FATOPN	R1 -> an 11-byte padded 8.3 name (e.g. "README  TXT");
;		find it in the CURRENT directory -> R0 = 0 found / 1 = not.
;		Sets up the file for FATRD.
;	FATRD	R2 -> 512-byte buffer; read the next sector of the open
;		file -> R0 = byte count in it (0 = end of file).
;	FATWR	R2 -> 512-byte buffer; OVERWRITE the next sector of the
;		open file in place -> R0 = bytes written (0 = done). Never
;		extends/allocates; stops at the file's existing size, so
;		the FAT and directory are left untouched. Re-open (FATOPN)
;		before switching between reading and writing a file.
;	FATWEN	R0 = cluster, R1 = value; write the FAT entry into every
;		FAT copy -> R0 = 0 ok / 1 error. (Allocation primitive.)
;	FATFREE	find a free cluster -> R0 = cluster number, 0 if none.
;	(FATNX R0=cluster -> R0 = the entry's value is the FAT reader.)
;	FATCRE	R1 -> 8.3 name, R2 -> data buffer, R3 = length (16-bit);
;		create a file in the root, allocating a cluster chain as
;		needed -> R0 = 0 ok / 2 exists / 3 no cluster / 4 dir full
;		/ 6 write error / 7 out of space mid-file. The buffer must
;		hold ceil(len/512) whole sectors.
;	FATDEL	R1 -> 8.3 name; delete the file from the root: free its
;		cluster chain and mark the entry 0xE5 -> R0 = 0 ok / 1 not
;		found / 2 write error.
;	FATREN	R1 -> old 8.3 name, R2 -> new 8.3 name; rename in the root
;		-> R0 = 0 ok / 1 not found / 2 new name exists / 3 write.
;
; Directory attribute bits: 0x10 dir, 0x08 volume label, 0x0F long name.

; ---- mount: MBR then BPB, then compute the region LBAs --------------

FATMNT:	CLR	R0			; read MBR (LBA 0)
	CLR	R1
	MOV	#FATBUF, R2
	JSR	PC, SDRD
	TST	R0
	BEQ	FM1
	MOV	#3, R0
	RTS	PC
FM1:	JSR	PC, FMSIG		; 55 AA at 0x1FE?
	BCC	FM2
	MOV	#1, R0
	RTS	PC
FM2:	MOV	#FATBUF+706, R1		; part-1 start LBA at 0x1C6 (lo word)
	JSR	PC, RDW
	MOV	R0, PSTART
	MOV	#FATBUF+710, R1		; 0x1C8 (hi word)
	JSR	PC, RDW
	MOV	R0, PSTART+2

	MOV	PSTART, R0		; read the BPB at the partition start
	MOV	PSTART+2, R1
	MOV	#FATBUF, R2
	JSR	PC, SDRD
	TST	R0
	BEQ	FM3
	MOV	#3, R0
	RTS	PC
FM3:	JSR	PC, FMSIG
	BCC	FM4
	MOV	#2, R0
	RTS	PC
FM4:	MOV	#FATBUF+15, R1		; 0x0D sectors/cluster (byte)
	JSR	PC, RDB
	MOV	R0, SPCLUS
	MOV	#FATBUF+16, R1		; 0x0E reserved sectors (word)
	JSR	PC, RDW
	MOV	R0, RESSEC
	MOV	#FATBUF+20, R1		; 0x10 number of FATs (byte)
	JSR	PC, RDB
	MOV	R0, NFATS
	MOV	#FATBUF+21, R1		; 0x11 root entry count (word)
	JSR	PC, RDW
	MOV	R0, RENTC
	MOV	#FATBUF+26, R1		; 0x16 sectors per FAT (word)
	JSR	PC, RDW
	MOV	R0, SPFAT

	MOV	PSTART, R0		; fatStart = partStart + reserved
	MOV	PSTART+2, R1
	ADD	RESSEC, R0
	ADC	R1
	MOV	R0, FATLBA
	MOV	R1, FATLBA+2

	MOV	NFATS, R2		; rootStart = fatStart + nFATs*secPerFAT
	MUL	R2, SPFAT		; R2:R3 = product (R2 hi, R3 lo)
	MOV	FATLBA, R0
	MOV	FATLBA+2, R1
	ADD	R3, R0
	ADC	R1
	ADD	R2, R1
	MOV	R0, ROOTLBA
	MOV	R1, ROOTLBA+2

	MOV	RENTC, R2		; rootDirSec = ceil(rentc*32 / 512)
	MUL	R2, #40			; R2:R3 = rentc * 32 (40 octal)
	ADD	#777, R3		; + 511 for the round-up
	ADC	R2
	MOV	#^D9, R4		; >>9  (÷512), logical
FMRS:	CLC
	ROR	R2
	ROR	R3
	SOB	R4, FMRS
	MOV	R3, RDSEC

	MOV	ROOTLBA, R0		; dataStart = rootStart + rootDirSec
	MOV	ROOTLBA+2, R1
	ADD	RDSEC, R0
	ADC	R1
	MOV	R0, DATALBA
	MOV	R1, DATALBA+2
	CLR	R0
	RTS	PC

; signature check on FATBUF: C clear if 55 AA at 0x1FE, else C set

FMSIG:	CLR	R0
	BISB	FATBUF+776, R0		; 0x1FE
	CMP	R0, #125		; 0x55
	BNE	FMSBAD
	CLR	R0
	BISB	FATBUF+777, R0		; 0x1FF
	CMP	R0, #252		; 0xAA
	BNE	FMSBAD
	CLC
	RTS	PC
FMSBAD:	SEC
	RTS	PC

; ---- cluster -> first LBA: R0 = cluster -> R0:R1 = LBA --------------
; LBA = dataStart + (cluster - 2) * sectorsPerCluster.  Clobbers R2/R3.

CLBA:	MOV	R0, R2
	SUB	#2, R2
	MUL	R2, SPCLUS		; R2:R3 = (clus-2)*spc
	MOV	DATALBA, R0
	MOV	DATALBA+2, R1
	ADD	R3, R0
	ADC	R1
	ADD	R2, R1
	RTS	PC

; ---- FAT lookup: R0 = cluster -> R0 = next cluster -----------------
; Entry N is a 16-bit LE word at byte N*2 of the FAT. Reads that FAT
; sector into FATBUF (so it invalidates the dir cache). 0xFFFF on error.

FATNX:	MOV	R0, R4
	SWAB	R4
	BIC	#177400, R4		; R4 = cluster >> 8  = FAT sector offset
	MOV	R0, R5
	BIC	#177400, R5		; R5 = cluster & 0xFF
	ASL	R5			; *2 = byte offset in the sector
	MOV	FATLBA, R0
	MOV	FATLBA+2, R1
	ADD	R4, R0
	ADC	R1
	MOV	#FATBUF, R2
	JSR	PC, SDRD
	CLR	DLOADED			; FATBUF no longer holds a dir sector
	TST	R0
	BNE	FNXE
	ADD	#FATBUF, R5
	MOV	(R5), R0		; LE word, R5 even
	RTS	PC
FNXE:	MOV	#177777, R0		; 0xFFFF -> treated as end of chain
	RTS	PC

; ---- directory iterator (root OR a subdirectory) -------------------
; The iterator walks whichever directory is current. The root is the
; fixed region at ROOTLBA (RDSEC sectors); a subdirectory is a cluster
; chain, read like a file. Set the current directory with:
;	FATDIR0	current = the root directory, rewound
;	FATCD	R0 = a subdirectory's first cluster (its DECLUS from a
;		listing; the ".." entry's cluster, or 0, is the root);
;		makes it current and rewinds
;	FATREW	rewind the current directory to its start
; then call FATNXT repeatedly, exactly as before.
;
; State: DMODE 0=root/1=subdir; DSTART subdir's first cluster; DCLUS
; the cluster now being read; DSEC sector index (root: into the region;
; subdir: within DCLUS); DENT entry within the sector; DLOADED = FATBUF
; holds the current dir sector.

FATDIR0:CLR	DMODE
	JSR	PC, FATREW
	RTS	PC

FATCD:	TST	R0
	BEQ	FATDIR0			; cluster 0 -> the root
	MOV	#1, DMODE
	MOV	R0, DSTART
	JSR	PC, FATREW
	RTS	PC

FATREW:	MOV	DSTART, DCLUS
	CLR	DSEC
	CLR	DENT
	CLR	DLOADED
	RTS	PC

FATNXT:	TST	DLOADED			; is the current sector in FATBUF?
	BNE	FNENT
	TST	DMODE			; no: load it, per mode
	BNE	FNSUB
	CMP	DSEC, RDSEC		; root: fixed region
	BHIS	FNEND
	MOV	ROOTLBA, R0
	MOV	ROOTLBA+2, R1
	ADD	DSEC, R0
	ADC	R1
	BR	FNLOAD
FNSUB:	CMP	DSEC, SPCLUS		; subdir: advance a cluster if needed
	BLO	FNSUB1
	MOV	DCLUS, R0
	JSR	PC, FATNX
	MOV	R0, DCLUS
	CLR	DSEC
FNSUB1:	CMP	DCLUS, #2		; end of the chain?
	BLO	FNEND
	CMP	DCLUS, #177770		; 0xFFF8
	BHIS	FNEND
	MOV	DCLUS, R0
	JSR	PC, CLBA
	ADD	DSEC, R0
	ADC	R1
FNLOAD:	MOV	R0, DELBA		; remember this dir sector's LBA,
	MOV	R1, DEHI		; so a matched entry can be written
	MOV	#FATBUF, R2
	JSR	PC, SDRD
	TST	R0
	BNE	FNEND
	MOV	#1, DLOADED
FNENT:	MOV	DENT, R2		; entry ptr = FATBUF + DENT*32
	ASL	R2
	ASL	R2
	ASL	R2
	ASL	R2
	ASL	R2
	ADD	#FATBUF, R2
	INC	DENT			; advance for the next call
	CMP	DENT, #^D16
	BLO	FN2
	CLR	DENT
	INC	DSEC
	CLR	DLOADED			; next call loads a fresh sector
FN2:	CLR	R0
	BISB	(R2), R0		; first name byte
	BEQ	FNEND			; 0x00 = no more entries
	CMP	R0, #345		; 0xE5 deleted
	BEQ	FATNXT
	CLR	R0
	BISB	13(R2), R0		; 0x0B attribute
	CMP	R0, #17			; 0x0F long-name entry
	BEQ	FATNXT
	BIT	#10, R0			; 0x08 volume label
	BNE	FATNXT
	MOV	R0, DEATTR
	MOV	R2, R3			; copy the 11-byte name
	MOV	#DENAME, R4
	MOV	#^D11, R5
FNCP:	MOVB	(R3)+, (R4)+
	SOB	R5, FNCP
	MOV	32(R2), DECLUS		; 0x1A first cluster (low)  [octal 32]
	MOV	34(R2), DESIZE		; 0x1C size low             [octal 34]
	MOV	36(R2), DESIZE+2	; 0x1E size high            [octal 36]
	MOV	R2, DEOFF		; entry's byte offset in FATBUF,
	SUB	#FATBUF, DEOFF		; paired with DELBA/DEHI above
	CLR	R0
	RTS	PC
FNEND:	MOV	#1, R0
	RTS	PC

; ---- open a named file in the current directory: R1 -> 8.3 name ----

FATOPN:	MOV	R1, SRCHN
	JSR	PC, FATREW
FO0:	JSR	PC, FATNXT
	TST	R0
	BNE	FONF
	MOV	#DENAME, R3
	MOV	SRCHN, R4
	MOV	#^D11, R5
FOC:	CMPB	(R3)+, (R4)+
	BNE	FO0
	SOB	R5, FOC
	MOV	DECLUS, FCLUS		; matched: set up the file
	MOV	DESIZE, FSIZE
	MOV	DESIZE+2, FSIZE+2
	CLR	FSECI
	CLR	R0
	RTS	PC
FONF:	MOV	#1, R0
	RTS	PC

; ---- read the next sector of the open file: R2 -> buffer -----------
; Returns R0 = bytes placed (0 = end of file).

FATRD:	TST	FSIZE			; remaining bytes == 0 -> EOF
	BNE	FR1
	TST	FSIZE+2
	BEQ	FREOF
FR1:	CMP	FCLUS, #2		; a valid data cluster?
	BLO	FREOF
	CMP	FCLUS, #177770		; 0xFFF8 end-of-chain
	BHIS	FREOF
	MOV	R2, -(SP)		; read cluster sector FSECI into buf
	MOV	FCLUS, R0
	JSR	PC, CLBA
	ADD	FSECI, R0
	ADC	R1
	MOV	(SP)+, R2
	JSR	PC, SDRD
	TST	R0
	BNE	FREOF
	TST	FSIZE+2			; bytes this sector = min(512, left)
	BNE	FRFULL
	CMP	FSIZE, #^D512
	BLO	FRPART
FRFULL:	MOV	#^D512, R3
	BR	FR2
FRPART:	MOV	FSIZE, R3
FR2:	SUB	R3, FSIZE		; remaining -= count (32-bit)
	SBC	FSIZE+2
	INC	FSECI			; next sector; cross cluster if needed
	CMP	FSECI, SPCLUS
	BLO	FR3
	CLR	FSECI
	MOV	R3, -(SP)		; FATNX clobbers R3 (the byte count)
	MOV	FCLUS, R0
	JSR	PC, FATNX
	MOV	R0, FCLUS
	MOV	(SP)+, R3
FR3:	MOV	R3, R0
	RTS	PC
FREOF:	CLR	R0
	RTS	PC

; ---- overwrite the next sector of the open file: R2 -> buffer -------
; The write twin of FATRD: writes one sector of the caller's data over
; the file's existing cluster chain and advances. OVERWRITE IN PLACE
; ONLY - it never extends the file or allocates, so it stops when the
; file's byte count is used up (nothing here touches the FAT or the
; directory). SDWR writes a full 512-byte sector; the caller's buffer is
; written whole, and the meaningful count (min 512, remaining) is what's
; returned and charged against the size. Returns R0 = bytes written
; (0 = done, or a write/chain error - check FSIZE: 0 = clean finish).

FATWR:	TST	FSIZE			; remaining bytes == 0 -> done
	BNE	FW1
	TST	FSIZE+2
	BEQ	FWEOF
FW1:	CMP	FCLUS, #2		; a valid data cluster?
	BLO	FWEOF
	CMP	FCLUS, #177770		; 0xFFF8 end-of-chain
	BHIS	FWEOF
	MOV	R2, -(SP)		; write buf to cluster sector FSECI
	MOV	FCLUS, R0
	JSR	PC, CLBA
	ADD	FSECI, R0
	ADC	R1
	MOV	(SP)+, R2
	JSR	PC, SDWR
	TST	R0
	BNE	FWEOF			; write error -> stop (FSIZE stays > 0)
	TST	FSIZE+2			; bytes this sector = min(512, left)
	BNE	FWFULL
	CMP	FSIZE, #^D512
	BLO	FWPART
FWFULL:	MOV	#^D512, R3
	BR	FW2
FWPART:	MOV	FSIZE, R3
FW2:	SUB	R3, FSIZE		; remaining -= count (32-bit)
	SBC	FSIZE+2
	INC	FSECI			; next sector; cross cluster if needed
	CMP	FSECI, SPCLUS
	BLO	FW3
	CLR	FSECI
	MOV	R3, -(SP)		; FATNX clobbers R3 (the byte count)
	MOV	FCLUS, R0
	JSR	PC, FATNX
	MOV	R0, FCLUS
	MOV	(SP)+, R3
FW3:	MOV	R3, R0
	RTS	PC
FWEOF:	CLR	R0
	RTS	PC

; ---- write a FAT entry: R0 = cluster, R1 = value --------------------
; Read-modify-write the entry into every FAT copy (they must stay in
; sync). FAT entry N is the 16-bit LE word at FAT byte N*2. Uses FATBUF,
; so it invalidates the dir cache. Returns R0 = 0 ok / 1 error.

FATWEN:	MOV	R1, WVAL
	MOV	R0, R4
	SWAB	R4
	BIC	#177400, R4		; sector offset = cluster >> 8
	MOV	R0, R5
	BIC	#177400, R5		; cluster & 0xFF
	ASL	R5			; *2 = byte offset in the sector
	MOV	R5, WBOFF
	MOV	FATLBA, R0		; FAT-copy-1 sector LBA
	MOV	FATLBA+2, R1
	ADD	R4, R0
	ADC	R1
	MOV	R0, F1LO
	MOV	R1, F1HI
	MOV	#FATBUF, R2		; read it
	JSR	PC, SDRD
	CLR	DLOADED
	TST	R0
	BNE	FWEER
	MOV	#FATBUF, R3		; patch the entry
	ADD	WBOFF, R3
	MOV	WVAL, (R3)
	MOV	F1LO, R0		; write FAT copy 1 back
	MOV	F1HI, R1
	MOV	#FATBUF, R2
	JSR	PC, SDWR
	TST	R0
	BNE	FWEER
	CMP	NFATS, #2		; and copy 2, if present (= +SPFAT)
	BLO	FWEOK
	MOV	F1LO, R0
	MOV	F1HI, R1
	ADD	SPFAT, R0
	ADC	R1
	MOV	#FATBUF, R2
	JSR	PC, SDWR
	TST	R0
	BNE	FWEER
FWEOK:	CLR	R0
	RTS	PC
FWEER:	MOV	#1, R0
	RTS	PC

; ---- find a free cluster -> R0 = cluster number, or 0 if none -------
; Scans the FAT a sector at a time (256 entries each) for a 0x0000
; entry, skipping the two reserved entries. Uses FATBUF (invalidates the
; dir cache). NOTE: bounded only by the FAT size, not the true cluster
; count, so on a full volume it could return an entry past the last real
; cluster; fine for a mostly-empty card. Proper bounding waits for the
; totalSectors-based cluster count when file creation lands.

FATFREE:CLR	R4			; FAT sector index
FFR1:	CMP	R4, SPFAT
	BHIS	FFRNONE
	MOV	FATLBA, R0
	MOV	FATLBA+2, R1
	ADD	R4, R0
	ADC	R1
	MOV	#FATBUF, R2
	JSR	PC, SDRD
	CLR	DLOADED
	TST	R0
	BNE	FFRNONE
	MOV	#FATBUF, R2		; scan 256 entries
	CLR	R3			; entry index
FFR2:	TST	(R2)			; free (0x0000)?
	BNE	FFR3
	TST	R4			; skip reserved clusters 0 and 1
	BNE	FFRGOT
	CMP	R3, #2
	BLO	FFR3
FFRGOT:	MOV	R4, R0			; cluster = sector*256 + index
	SWAB	R0
	ADD	R3, R0
	RTS	PC
FFR3:	ADD	#2, R2
	INC	R3
	CMP	R3, #^D256
	BLO	FFR2
	INC	R4
	BR	FFR1
FFRNONE:	CLR	R0
	RTS	PC

; ---- find a free root-directory slot -------------------------------
; Scans the fixed root region for an entry marked free (0x00 = never
; used) or deleted (0xE5). On success FATBUF holds that sector, DSLBA/
; DSHI = its LBA, DSOFF = the entry's byte offset in FATBUF. R0 = 0 ok /
; 1 = directory full. Root only.

FATSLOT:CLR	R4			; root sector index
FSL1:	CMP	R4, RDSEC
	BHIS	FSLNON
	MOV	ROOTLBA, R0
	MOV	ROOTLBA+2, R1
	ADD	R4, R0
	ADC	R1
	MOV	R0, DSLBA
	MOV	R1, DSHI
	MOV	#FATBUF, R2
	JSR	PC, SDRD
	CLR	DLOADED
	TST	R0
	BNE	FSLNON
	MOV	#FATBUF, R2		; scan the 16 entries
	CLR	R3
FSL2:	CLR	R0
	BISB	(R2), R0
	BEQ	FSLGOT			; 0x00 never used
	CMP	R0, #345		; 0xE5 deleted
	BEQ	FSLGOT
	ADD	#40, R2			; next entry (32 bytes)
	INC	R3
	CMP	R3, #^D16
	BLO	FSL2
	INC	R4
	BR	FSL1
FSLGOT:	MOV	R2, R0			; byte offset in FATBUF
	SUB	#FATBUF, R0
	MOV	R0, DSOFF
	CLR	R0
	RTS	PC
FSLNON:	MOV	#1, R0
	RTS	PC

; ---- create a small file in the root directory ---------------------
; R1 -> 11-byte 8.3 name, R2 -> a 512-byte data buffer, R3 = length in
; bytes. ONE cluster / ONE sector for now (length <= 512): allocates a
; cluster, marks it EOC, writes a directory entry, and writes the data.
; Returns R0 = 0 ok / 2 already exists / 3 no free cluster / 4 dir full
; / 5 too big / 6 write error.

FATCRE:	MOV	R1, CRNAME
	MOV	R2, CRDATA
	MOV	R3, CRLEN
	JSR	PC, FATDIR0		; create in (and search) the root
	MOV	CRNAME, R1		; already present?
	JSR	PC, FATOPN
	TST	R0
	BNE	FCR1
	MOV	#2, R0
	RTS	PC
FCR1:	JSR	PC, FATFREE		; allocate the first cluster
	TST	R0
	BNE	FCR2
	MOV	#3, R0
	RTS	PC
FCR2:	MOV	R0, CRCLUS
	MOV	#177777, R1		; mark it end-of-chain
	JSR	PC, FATWEN
	TST	R0
	BEQ	FCR3
	MOV	#6, R0
	RTS	PC
FCR3:	JSR	PC, FATSLOT		; a place for the directory entry
	TST	R0
	BEQ	FCR4
	MOV	CRCLUS, R0		; dir full: give the cluster back
	CLR	R1
	JSR	PC, FATWEN
	MOV	#4, R0
	RTS	PC
FCR4:	MOV	#FATBUF, R3		; zero the 32-byte entry
	ADD	DSOFF, R3
	MOV	R3, R2
	MOV	#^D16, R4
FCZ:	CLR	(R2)+
	SOB	R4, FCZ
	MOV	R3, R2			; name (11 bytes)
	MOV	CRNAME, R4
	MOV	#^D11, R5
FCN:	MOVB	(R4)+, (R2)+
	SOB	R5, FCN
	MOVB	#40, 13(R3)		; 0x0B attribute = 0x20 (archive)
	MOV	CRCLUS, 32(R3)		; 0x1A first cluster low
	MOV	CRLEN, 34(R3)		; 0x1C size low
	CLR	36(R3)			; 0x1E size high
	MOV	DSLBA, R0		; write the directory sector back
	MOV	DSHI, R1
	MOV	#FATBUF, R2
	JSR	PC, SDWR
	TST	R0
	BEQ	FCR5
	MOV	#6, R0
	RTS	PC
FCR5:	MOV	CRCLUS, WRCUR		; write the data, extending as needed
	CLR	WRSEC			; sector within the current cluster
	MOV	CRDATA, WRPTR		; source pointer
	MOV	CRLEN, WRREM		; bytes still to write (16-bit)
FCWL:	TST	WRREM
	BEQ	FCR6			; all written
	MOV	WRCUR, R0		; write one sector
	JSR	PC, CLBA
	ADD	WRSEC, R0
	ADC	R1
	MOV	WRPTR, R2
	JSR	PC, SDWR
	TST	R0
	BNE	FCWER
	ADD	#^D512, WRPTR		; advance source + remaining
	CMP	WRREM, #^D512
	BLO	FCWLST
	SUB	#^D512, WRREM
	BR	FCWADV
FCWLST:	CLR	WRREM			; last (partial) sector
FCWADV:	INC	WRSEC			; next sector; new cluster if full
	CMP	WRSEC, SPCLUS
	BLO	FCWL
	TST	WRREM			; cluster full and more to write?
	BEQ	FCR6
	JSR	PC, FATFREE		; extend: grab the next cluster
	TST	R0
	BEQ	FCWNSP			; 0 = no free cluster left
	MOV	R0, WRNXT
	MOV	WRCUR, R0		; link current -> next
	MOV	WRNXT, R1
	JSR	PC, FATWEN
	TST	R0
	BNE	FCWER
	MOV	WRNXT, R0		; mark next end-of-chain
	MOV	#177777, R1
	JSR	PC, FATWEN
	TST	R0
	BNE	FCWER
	MOV	WRNXT, WRCUR
	CLR	WRSEC
	BR	FCWL
FCR6:	CLR	R0
	RTS	PC
FCWER:	MOV	#6, R0
	RTS	PC
FCWNSP:	MOV	#7, R0			; ran out of space mid-file
	RTS	PC

; ---- delete a file: R1 -> 11-byte 8.3 name -------------------------
; Frees the file's whole cluster chain (each entry -> 0x0000) and marks
; its directory entry deleted (0xE5). Root only. The iterator recorded
; the entry's location (DELBA/DEHI/DEOFF) and first cluster (FCLUS) when
; FATOPN matched it. Returns R0 = 0 ok / 1 not found / 2 write error.

FATDEL:	MOV	R1, CRNAME
	JSR	PC, FATDIR0
	MOV	CRNAME, R1
	JSR	PC, FATOPN
	TST	R0
	BEQ	FD1
	MOV	#1, R0
	RTS	PC
FD1:	MOV	FCLUS, CHCUR		; walk and free the chain
FDCH:	CMP	CHCUR, #2
	BLO	FDMARK
	CMP	CHCUR, #177770		; 0xFFF8 end-of-chain
	BHIS	FDMARK
	MOV	CHCUR, R0		; next = FATNX(cur) BEFORE freeing cur
	JSR	PC, FATNX
	MOV	R0, CHNXT
	MOV	CHCUR, R0		; free cur
	CLR	R1
	JSR	PC, FATWEN
	TST	R0
	BNE	FDERR
	MOV	CHNXT, CHCUR
	BR	FDCH
FDMARK:	MOV	DELBA, R0		; mark the directory entry deleted
	MOV	DEHI, R1
	MOV	#FATBUF, R2
	JSR	PC, SDRD
	CLR	DLOADED
	TST	R0
	BNE	FDERR
	MOV	#FATBUF, R3
	ADD	DEOFF, R3
	MOVB	#345, (R3)		; 0xE5
	MOV	DELBA, R0
	MOV	DEHI, R1
	MOV	#FATBUF, R2
	JSR	PC, SDWR
	TST	R0
	BNE	FDERR
	CLR	R0
	RTS	PC
FDERR:	MOV	#2, R0
	RTS	PC

; ---- rename a file: R1 -> old 8.3 name, R2 -> new 8.3 name ----------
; Overwrites the 11-byte name in the existing directory entry (located
; via DELBA/DEHI/DEOFF, recorded by the iterator when FATOPN matched).
; Root only. R0 = 0 ok / 1 not found / 2 target name exists / 3 write.

FATREN:	MOV	R2, RNNEW		; stash the new-name pointer
	JSR	PC, FATDIR0
	JSR	PC, FATOPN		; R1 = old name; find it
	TST	R0
	BEQ	FRN1
	MOV	#1, R0
	RTS	PC
FRN1:	MOV	DELBA, RNLBA		; save the entry's location
	MOV	DEHI, RNHI
	MOV	DEOFF, RNOFF
	MOV	RNNEW, R1		; new name must not already exist
	JSR	PC, FATDIR0
	JSR	PC, FATOPN
	TST	R0
	BNE	FRN2
	MOV	#2, R0
	RTS	PC
FRN2:	MOV	RNLBA, R0		; re-read the entry's sector
	MOV	RNHI, R1
	MOV	#FATBUF, R2
	JSR	PC, SDRD
	CLR	DLOADED
	TST	R0
	BNE	FRNER
	MOV	#FATBUF, R2		; overwrite the 11 name bytes
	ADD	RNOFF, R2
	MOV	RNNEW, R3
	MOV	#^D11, R4
FRNCP:	MOVB	(R3)+, (R2)+
	SOB	R4, FRNCP
	MOV	RNLBA, R0		; write it back
	MOV	RNHI, R1
	MOV	#FATBUF, R2
	JSR	PC, SDWR
	TST	R0
	BNE	FRNER
	CLR	R0
	RTS	PC
FRNER:	MOV	#3, R0
	RTS	PC

; ---- little-endian readers from a (maybe odd) byte pointer R1 ------
; RDW -> R0 = 16-bit LE word.  RDB -> R0 = zero-extended byte.  Keep R1.

RDW:	CLR	R0
	BISB	1(R1), R0
	SWAB	R0
	BISB	(R1), R0
	RTS	PC
RDB:	CLR	R0
	BISB	(R1), R0
	RTS	PC

; ---- geometry + iterator state + sector buffer ---------------------

	.EVEN
PSTART:	.WORD	0, 0		; partition start LBA
FATLBA:	.WORD	0, 0		; first FAT sector
ROOTLBA:.WORD	0, 0		; first root-directory sector
DATALBA:.WORD	0, 0		; first data sector (cluster 2)
SPCLUS:	.WORD	0		; sectors per cluster
RESSEC:	.WORD	0		; reserved sectors
NFATS:	.WORD	0		; number of FATs
RENTC:	.WORD	0		; root entry count
SPFAT:	.WORD	0		; sectors per FAT
RDSEC:	.WORD	0		; root-directory sectors
DMODE:	.WORD	0		; iterator: 0 = root, 1 = subdirectory
DSTART:	.WORD	0		; subdirectory's first cluster
DCLUS:	.WORD	0		; cluster now being read (subdir mode)
DSEC:	.WORD	0		; sector index (region, or within cluster)
DENT:	.WORD	0		; entry within the sector
DLOADED:.WORD	0		; FATBUF holds the current dir sector
DEATTR:	.WORD	0		; current entry: attribute
DECLUS:	.WORD	0		;               first cluster
DESIZE:	.WORD	0, 0		;               size (low, high)
SRCHN:	.WORD	0		; FATOPN: name being searched for
FCLUS:	.WORD	0		; open file: current cluster
FSIZE:	.WORD	0, 0		;            bytes remaining (low, high)
FSECI:	.WORD	0		;            sector within the cluster
WVAL:	.WORD	0		; FATWEN: value being written
WBOFF:	.WORD	0		;         byte offset in the FAT sector
F1LO:	.WORD	0		;         FAT-copy-1 sector LBA (low)
F1HI:	.WORD	0		;         FAT-copy-1 sector LBA (high)
DSLBA:	.WORD	0		; FATSLOT: slot sector LBA (low)
DSHI:	.WORD	0		;          slot sector LBA (high)
DSOFF:	.WORD	0		;          slot byte offset in FATBUF
CRNAME:	.WORD	0		; FATCRE: name pointer
CRDATA:	.WORD	0		;         data buffer pointer
CRLEN:	.WORD	0		;         length in bytes
CRCLUS:	.WORD	0		;         allocated first cluster
DELBA:	.WORD	0		; matched entry's sector LBA (low)
DEHI:	.WORD	0		;                            (high)
DEOFF:	.WORD	0		; matched entry's byte offset in FATBUF
CHCUR:	.WORD	0		; FATDEL: chain cursor
CHNXT:	.WORD	0		;         next cluster in the chain
WRCUR:	.WORD	0		; FATCRE data write: current cluster
WRSEC:	.WORD	0		;                    sector within it
WRPTR:	.WORD	0		;                    source pointer
WRREM:	.WORD	0		;                    bytes remaining
WRNXT:	.WORD	0		;                    newly-allocated cluster
RNNEW:	.WORD	0		; FATREN: new-name pointer
RNLBA:	.WORD	0		;         old entry's sector LBA (low)
RNHI:	.WORD	0		;                              (high)
RNOFF:	.WORD	0		;         old entry's byte offset
DENAME:	.BLKB	^D11		; current entry name (8.3, space padded)
	.EVEN
FATBUF:	.BLKB	^D512		; one sector: MBR / BPB / dir / FAT
	.EVEN
