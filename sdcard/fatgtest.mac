; fatgtest.mac — FAT16 geometry + free-cluster bound (MAXCLUS)
;
; Mounts, prints the total sector count and the computed cluster count
; (MAXCLUS = last valid cluster = count + 1), then asks FATFREE for a
; free cluster and checks it is nonzero and within range. This exercises
; the totalSectors-based bound added to FATFREE (which stops it handing
; back a cluster past the end of the data region on a full volume).
;
; Assemble:	part of fatgtest.prj (origin 1000); run with P or 1000G.

.	= 1000

XCSR	= 177564		; console transmit status (bit 7 = ready)
XBUF	= 177566		; console transmit buffer

START:	MOV	#340, @#177776	; priority 7
	MOV	#1000, SP
	MOV	#MHELLO, R1
	JSR	PC, PMSG

	JSR	PC, SDINI
	TST	R0
	BEQ	MOUNT
	MOV	#MNOSD, R1
	JSR	PC, PMSG
	HALT
MOUNT:	JSR	PC, FATMNT
	TST	R0
	BEQ	GEOM
	MOV	#MNOMNT, R1
	JSR	PC, PMSG
	HALT

; ---- print the geometry ---------------------------------------------

GEOM:	MOV	#MTOT, R1
	JSR	PC, PMSG
	MOV	TOTSEC+2, R0	; total sectors (high word, then low)
	JSR	PC, PHEX4
	MOV	TOTSEC, R0
	JSR	PC, PHEX4
	JSR	PC, PCRLF

	MOV	#MSPC, R1
	JSR	PC, PMSG
	MOV	SPCLUS, R0	; sectors per cluster
	JSR	PC, PHEX4
	JSR	PC, PCRLF

	MOV	#MCNT, R1
	JSR	PC, PMSG
	MOV	MAXCLUS, R0	; cluster count = MAXCLUS - 1
	DEC	R0
	JSR	PC, PHEX4
	JSR	PC, PCRLF

	MOV	#MMAX, R1
	JSR	PC, PMSG
	MOV	MAXCLUS, R0
	JSR	PC, PHEX4
	JSR	PC, PCRLF

; ---- FATFREE must return a nonzero, in-range cluster ----------------

	JSR	PC, FATFREE
	MOV	R0, R4
	MOV	#MFREE, R1
	JSR	PC, PMSG
	MOV	R4, R0
	JSR	PC, PHEX4
	JSR	PC, PCRLF

	TST	R4
	BNE	CHK
	MOV	#MNONE, R1
	JSR	PC, PMSG
	HALT
CHK:	CMP	R4, MAXCLUS	; must be <= MAXCLUS
	BLOS	INRNG
	MOV	#MOOR, R1
	JSR	PC, PMSG
	HALT
INRNG:	CMP	R4, #2		; and >= 2
	BHIS	OK
	MOV	#MOOR, R1
	JSR	PC, PMSG
	HALT
OK:	MOV	#MOK, R1
	JSR	PC, PMSG
	HALT
	JMP	START

; ---- console ---------------------------------------------------------

PMSG:	MOVB	(R1)+, R0
	BEQ	PMSG2
	JSR	PC, PUTC
	BR	PMSG
PMSG2:	RTS	PC

PCRLF:	MOV	#15, R0
	JSR	PC, PUTC
	MOV	#12, R0
	JSR	PC, PUTC
	RTS	PC

PUTC:	TSTB	@#XCSR
	BPL	PUTC
	MOVB	R0, @#XBUF
	RTS	PC

PHEX4:	MOV	R0, -(SP)
	SWAB	R0
	JSR	PC, PHEX2
	MOV	(SP)+, R0
	JSR	PC, PHEX2
	RTS	PC

PHEX2:	BIC	#177400, R0
	MOV	R0, -(SP)
	ASR	R0
	ASR	R0
	ASR	R0
	ASR	R0
	JSR	PC, PNIB
	MOV	(SP)+, R0
	JSR	PC, PNIB
	RTS	PC

PNIB:	BIC	#177760, R0
	CMP	R0, #^D9
	BGT	PNA
	ADD	#60, R0
	BR	PNP
PNA:	ADD	#^D55, R0
PNP:	JSR	PC, PUTC
	RTS	PC

; ---- messages -------------------------------------------------------

MHELLO:	.ASCII	/FATGTEST - geometry + free-cluster bound/
	.BYTE	15, 12, 0
MNOSD:	.ASCII	/SD INIT FAILED/
	.BYTE	15, 12, 0
MNOMNT:	.ASCII	/MOUNT FAILED/
	.BYTE	15, 12, 0
MTOT:	.ASCII	/TOTAL SECTORS /
	.BYTE	0
MSPC:	.ASCII	/SEC PER CLUS  /
	.BYTE	0
MCNT:	.ASCII	/CLUSTER COUNT /
	.BYTE	0
MMAX:	.ASCII	/MAX CLUSTER   /
	.BYTE	0
MFREE:	.ASCII	/FIRST FREE    /
	.BYTE	0
MNONE:	.ASCII	/NO FREE CLUSTER/
	.BYTE	15, 12, 0
MOOR:	.ASCII	/FREE CLUSTER OUT OF RANGE/
	.BYTE	15, 12, 0
MOK:	.ASCII	/--- FREE CLUSTER IN RANGE - OK/
	.BYTE	15, 12, 0
	.EVEN

	.INCLUDE "fat16.mac"
	.INCLUDE "sd.mac"

	.END	START
