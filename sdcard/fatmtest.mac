; fatmtest.mac — FAT16 make-directory test (fat16.mac FATMKD)
;
; Creates the subdirectory NEWDIR in the root, verifies it is a
; directory, descends into it and confirms the "." and ".." entries,
; then removes it (an empty directory is just a one-cluster chain, so
; FATDEL cleans it up). Self-cleaning and re-runnable.
;
; Assemble:	part of fatmtest.prj (origin 1000); run with P or 1000G.

.	= 1000

XCSR	= 177564		; console transmit status (bit 7 = ready)
XBUF	= 177566		; console transmit buffer

START:	MOV	#340, @#177776	; priority 7
	MOV	#1000, SP
	MOV	#MHELLO, R1
	JSR	PC, PMSG

	JSR	PC, SDINI
	TST	R0
	BEQ	MOUNT
	MOV	#MNOSD, R1
	JSR	PC, PMSG
	HALT
MOUNT:	JSR	PC, FATMNT
	TST	R0
	BEQ	MKD
	MOV	#MNOMNT, R1
	JSR	PC, PMSG
	HALT

; ---- make the directory ---------------------------------------------

MKD:	MOV	#DNAME, R1	; clear any leftover
	JSR	PC, FATDEL

	MOV	#DNAME, R1
	JSR	PC, FATMKD
	MOV	R0, R4
	TST	R4
	BEQ	MKOK
	MOV	#MMERR, R1
	JSR	PC, PMSG
	MOV	R4, R0
	ADD	#60, R0
	JSR	PC, PUTC
	JSR	PC, PCRLF
	HALT
MKOK:	MOV	#MMADE, R1
	JSR	PC, PMSG

; ---- verify it's a directory ----------------------------------------

	MOV	#DNAME, R1
	JSR	PC, FATOPN
	TST	R0
	BEQ	VD1
	MOV	#MNOF, R1
	JSR	PC, PMSG
	HALT
VD1:	BIT	#20, DEATTR	; 0x10 = directory
	BNE	VD2
	MOV	#MNOTD, R1
	JSR	PC, PMSG
	HALT
VD2:	MOV	#MISDIR, R1
	JSR	PC, PMSG
	MOV	DECLUS, R0	; print its cluster
	JSR	PC, PHEX4
	JSR	PC, PCRLF

; ---- descend and check the "." and ".." entries ---------------------

	MOV	DECLUS, R0
	JSR	PC, FATCD	; make NEWDIR current
	JSR	PC, FATNXT	; entry 1 must be "."
	TST	R0
	BNE	DOTBAD
	CLR	R0
	BISB	DENAME, R0
	CMP	R0, #56		; '.'
	BNE	DOTBAD
	JSR	PC, FATNXT	; entry 2 must be ".."
	TST	R0
	BNE	DOTBAD
	CLR	R0
	BISB	DENAME, R0
	CMP	R0, #56
	BNE	DOTBAD
	CLR	R0
	BISB	DENAME+1, R0
	CMP	R0, #56
	BNE	DOTBAD
	MOV	#MDOTOK, R1
	JSR	PC, PMSG
	BR	CLEAN
DOTBAD:	MOV	#MDOTNO, R1
	JSR	PC, PMSG
	HALT

; ---- remove it and confirm gone -------------------------------------

CLEAN:	MOV	#DNAME, R1
	JSR	PC, FATDEL
	TST	R0
	BEQ	CL1
	MOV	#MRMERR, R1
	JSR	PC, PMSG
	HALT
CL1:	MOV	#DNAME, R1
	JSR	PC, FATOPN
	TST	R0
	BNE	GONE
	MOV	#MSTILL, R1
	JSR	PC, PMSG
	HALT
GONE:	MOV	#MDONE, R1
	JSR	PC, PMSG
	HALT
	JMP	START

; ---- console ---------------------------------------------------------

PMSG:	MOVB	(R1)+, R0
	BEQ	PMSG2
	JSR	PC, PUTC
	BR	PMSG
PMSG2:	RTS	PC

PCRLF:	MOV	#15, R0
	JSR	PC, PUTC
	MOV	#12, R0
	JSR	PC, PUTC
	RTS	PC

PUTC:	TSTB	@#XCSR
	BPL	PUTC
	MOVB	R0, @#XBUF
	RTS	PC

PHEX4:	MOV	R0, -(SP)
	SWAB	R0
	JSR	PC, PHEX2
	MOV	(SP)+, R0
	JSR	PC, PHEX2
	RTS	PC

PHEX2:	BIC	#177400, R0
	MOV	R0, -(SP)
	ASR	R0
	ASR	R0
	ASR	R0
	ASR	R0
	JSR	PC, PNIB
	MOV	(SP)+, R0
	JSR	PC, PNIB
	RTS	PC

PNIB:	BIC	#177760, R0
	CMP	R0, #^D9
	BGT	PNA
	ADD	#60, R0
	BR	PNP
PNA:	ADD	#^D55, R0
PNP:	JSR	PC, PUTC
	RTS	PC

; ---- name and messages ----------------------------------------------

DNAME:	.ASCII	/NEWDIR     /	; 8.3: NEWDIR + 5 spaces (no extension)
	.EVEN

MHELLO:	.ASCII	/FATMTEST - make directory NEWDIR/
	.BYTE	15, 12, 0
MNOSD:	.ASCII	/SD INIT FAILED/
	.BYTE	15, 12, 0
MNOMNT:	.ASCII	/MOUNT FAILED/
	.BYTE	15, 12, 0
MMERR:	.ASCII	/MKDIR ERROR CODE /
	.BYTE	0
MMADE:	.ASCII	/CREATED NEWDIR/
	.BYTE	15, 12, 0
MNOF:	.ASCII	/NEWDIR NOT FOUND/
	.BYTE	15, 12, 0
MNOTD:	.ASCII	/NOT A DIRECTORY/
	.BYTE	15, 12, 0
MISDIR:	.ASCII	/IS A DIRECTORY, cluster /
	.BYTE	0
MDOTOK:	.ASCII	/HAS . AND .. ENTRIES/
	.BYTE	15, 12, 0
MDOTNO:	.ASCII	/MISSING . / .. ENTRIES/
	.BYTE	15, 12, 0
MRMERR:	.ASCII	/REMOVE FAILED/
	.BYTE	15, 12, 0
MSTILL:	.ASCII	/STILL PRESENT AFTER REMOVE/
	.BYTE	15, 12, 0
MDONE:	.ASCII	/--- DONE (created, verified, removed)/
	.BYTE	15, 12, 0
	.EVEN

	.INCLUDE "fat16.mac"
	.INCLUDE "sd.mac"

	.END	START
